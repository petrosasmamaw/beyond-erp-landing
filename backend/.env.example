# ===================================================================
# Neon Serverless PostgreSQL Database Configuration
# ===================================================================
# 1. Pooled Connection (Recommended for backend application queries)
# Replace with your actual Neon pooled connection string:
DATABASE_URL="postgresql://neondb_owner:npg_demo_secret_key_12345@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Direct Connection (Used by Prisma CLI for migrations and db push)
# Replace with your actual Neon unpooled direct connection string:
DIRECT_URL="postgresql://neondb_owner:npg_demo_secret_key_12345@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ===================================================================
# Backend Server Configuration
# ===================================================================
API_PORT=4000
NODE_ENV="development"

# Allowed web origins for CORS (supports comma-separated list for Next.js frontend)
WEB_ORIGIN="http://localhost:8080,http://localhost:3000"

# ===================================================================
# Security & JWT Authentication
# ===================================================================
JWT_SECRET="beyond_erp_super_secure_jwt_secret_demo_key_9876543210"
JWT_EXPIRES_IN="8h"

# ===================================================================
# SMTP / Email Configuration (Optional)
# ===================================================================
# If SMTP_HOST is empty, emails will be logged to console in development.
MAIL_FROM="Beyond ERP <no-reply@beyond.et>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="beyondsolutionsupport@gmail.com"
SMTP_PASS="demo_email_app_password_abcd1234"
