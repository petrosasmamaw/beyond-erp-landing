# ===================================================================
# Frontend Configuration & Backend Connection
# ===================================================================
# Backend URL used by Next.js rewrites (server-to-server) and direct browser API calls
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Set to true only if you want to use local in-memory offline mock data instead of Neon DB backend
NEXT_PUBLIC_MOCK=false
